{
  "name": "cutaway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build && vite build -c vite.embed.config.ts",
    "preview": "vite preview --port 5181 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backtest": "vitest run src/lib/forecast.test.ts --mode backtest --reporter=verbose",
    "budget": "node scripts/budget.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run budget",
    "models": "node tools/models/build.mjs",
    "film:capture": "node tools/film/capture.mjs",
    "film:encode": "node tools/film/encode.mjs"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "lucide-react": "^1.48.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
